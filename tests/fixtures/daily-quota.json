{
  "_doc": "Cas de test pour le calcul de charge et quotas journaliers PF (art. 5, arrêté n° 2018-199 CM).",
  "entries": [
    {
      "desc": "Palanquée air prévue sans réalisation (2 plongeurs)",
      "dive": {
        "id": "dive-1",
        "palanquees": [
          {
            "id": "p1",
            "profMax": 20,
            "duree": 45,
            "melanges": ["Air"],
            "membres": [
              { "diverId": "d1", "aptitude": "PE-20" },
              { "diverId": "d2", "aptitude": "PA-20" }
            ]
          }
        ]
      },
      "expected": [
        { "diveId": "dive-1", "diverId": "d1", "profMax": 20, "duree": 45, "trimix": false },
        { "diveId": "dive-1", "diverId": "d2", "profMax": 20, "duree": 45, "trimix": false }
      ]
    },
    {
      "desc": "Réalisé écrase le prévu (profMax et duree)",
      "dive": {
        "id": "dive-2",
        "palanquees": [
          {
            "id": "p1",
            "profMax": 20,
            "duree": 40,
            "melanges": ["Nx ≤ 40%"],
            "membres": [
              { "diverId": "d1", "aptitude": "PE-20" }
            ]
          }
        ],
        "render_state": {
          "realises": {
            "p1": { "profMax": 25.5, "duree": 52 }
          }
        }
      },
      "expected": [
        { "diveId": "dive-2", "diverId": "d1", "profMax": 25.5, "duree": 52, "trimix": false }
      ]
    },
    {
      "desc": "Exclusion des baptêmes et membres sans diverId",
      "dive": {
        "id": "dive-3",
        "palanquees": [
          {
            "id": "p1",
            "profMax": 6,
            "duree": 20,
            "melanges": ["Air"],
            "membres": [
              { "diverId": "d1", "aptitude": "Baptême" },
              { "diverId": "d2", "_bapteme": true },
              { "aptitude": "PE-12" },
              { "diverId": "d3", "aptitude": "ENS-06" }
            ]
          }
        ]
      },
      "expected": [
        { "diveId": "dive-3", "diverId": "d3", "profMax": 6, "duree": 20, "trimix": false }
      ]
    },
    {
      "desc": "Trimix détecté via melanges contenant Tx",
      "dive": {
        "id": "dive-4",
        "palanquees": [
          {
            "id": "p1",
            "profMax": 65,
            "duree": 35,
            "melanges": ["Tx", "Nx > 40%"],
            "membres": [
              { "diverId": "d4", "aptitude": "PA-50" }
            ]
          }
        ]
      },
      "expected": [
        { "diveId": "dive-4", "diverId": "d4", "profMax": 65, "duree": 35, "trimix": true }
      ]
    },
    {
      "desc": "render_state sous forme de chaîne JSON",
      "dive": {
        "id": "dive-5",
        "palanquees": [
          {
            "id": "p1",
            "profMax": 15,
            "duree": 40,
            "melanges": ["Air"],
            "membres": [
              { "diverId": "d5", "aptitude": "PE-20" }
            ]
          }
        ],
        "render_state": "{\"realises\":{\"p1\":{\"profMax\":\"18\",\"duree\":\"45\"}}}"
      },
      "expected": [
        { "diveId": "dive-5", "diverId": "d5", "profMax": 18, "duree": 45, "trimix": false }
      ]
    },
    {
      "desc": "Même plongeur présent dans deux palanquées d'une même plongée",
      "dive": {
        "id": "dive-6",
        "palanquees": [
          {
            "id": "p1",
            "profMax": 20,
            "duree": 40,
            "melanges": ["Air"],
            "membres": [
              { "diverId": "guide", "aptitude": "GP-40" },
              { "diverId": "d1", "aptitude": "PE-20" }
