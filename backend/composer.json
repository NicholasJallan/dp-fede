{
  "name": "dp-fede/api",
  "description": "DP Assistant — backend PHP (FFESSM / Code du Sport)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "classmap": ["lib/"]
  },
  "autoload-dev": {
    "psr-4": {
      "DpFede\\Tests\\": "tests-php/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --colors=always"
  },
  "config": {
    "sort-packages": true
  }
}
