# /etc/cron.d/dp-fede — tâches planifiées de DP Assistant.
# Installation : sudo install -o root -g root -m 644 deploy/cron.example /etc/cron.d/dp-fede
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Sauvegarde MariaDB (dump vérifié, rétention : /etc/dp-fede/backup.env)
30 2 * * * root /usr/local/sbin/dp-fede-backup >> /var/log/dp-fede-backup.log 2>&1
# Sauvegarde des fiches PDF archivées (hors base, A322-72), 30 jours
45 2 * * * root tar czf /var/backups/dp-fede/documents-$(date +\%Y\%m\%d).tgz -C /var/lib/dp-fede documents && find /var/backups/dp-fede -name 'documents-*.tgz' -mtime +30 -delete
# Purge RGPD / sessions expirées
15 3 * * * www-data /usr/bin/php8.5 /var/www/dp-fede-api/bin/purge.php >> /var/log/dp-fede-purge.log 2>&1
# Reprise des PDF d'archive en échec ou interrompus
40 * * * * www-data /usr/bin/php8.5 /var/www/dp-fede-api/bin/documents.php --retry >> /var/log/dp-fede-documents.log 2>&1
