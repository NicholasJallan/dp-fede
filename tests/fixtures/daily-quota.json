          },
          {
            "id": "p2",
            "profMax": 15,
            "duree": 35,
            "melanges": ["Air"],
            "membres": [
              { "diverId": "guide", "aptitude": "GP-40" },
              { "diverId": "d2", "aptitude": "PE-20" }
