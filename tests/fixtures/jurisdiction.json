    { "in": "  FR  ", "out": "FR" },
    { "in": "FRA", "out": "FR" },
    { "in": "CH", "out": "FR" },
    { "in": "ES", "out": "FR" },
    { "in": "XX", "out": "FR" },
    { "in": "", "out": null },
    { "in": "   ", "out": null },
    { "in": null, "out": null }
  ],
  "resolve": [
    { "pays": "PF", "club": "FR", "out": "PF", "desc": "pays PF + club FR → PF (le lieu prime)" },
    { "pays": "PYF", "club": "FR", "out": "PF", "desc": "pays PYF (alpha-3) + club FR → PF (le lieu prime)" },
    { "pays": "pf", "club": "FR", "out": "PF", "desc": "pays pf minuscule + club FR → PF" },
    { "pays": "  PF  ", "club": "FR", "out": "PF", "desc": "pays PF avec espaces + club FR → PF" },
