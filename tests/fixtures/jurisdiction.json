    { "pays": null, "club": "XX", "out": "FR", "desc": "pays null + club invalide → FR (défaut)" },
    { "pays": "PF", "club": null, "out": "PF", "desc": "pays PF + club null → PF" },
    { "pays": "FR", "club": null, "out": "FR", "desc": "pays FR + club null → FR" },
    { "pays": "PF", "club": "PF", "out": "PF", "desc": "pays PF + club PF → PF" },
    { "pays": "FR", "club": "FR", "out": "FR", "desc": "pays FR + club FR → FR" }
  ]
