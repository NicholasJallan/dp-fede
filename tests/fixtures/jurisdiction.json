    { "in": "XX", "out": null },
    { "in": "CH", "out": null },
    { "in": "PYF", "out": null },
    { "in": 123, "out": null },
    { "in": {}, "out": null },
    { "in": [], "out": null }
  ],
  "forCountry": [
    { "in": "PF", "out": "PF" },
