# /etc/dp-fede/backup.env — configuration de dp-fede-backup (deploy/backup.sh)
#
# Installation :
#   sudo install -o root -g root -m 600 deploy/backup.env.example /etc/dp-fede/backup.env
#   sudo $EDITOR /etc/dp-fede/backup.env
# Le script refuse de tourner si ce fichier n'est pas en mode 600 (ou 400).
# Format : affectations shell (VAR=valeur), lues par `source`.

# ── Base ────────────────────────────────────────────────────────────────────
DB_NAME=dp_fede
DB_HOST=localhost

# Option A (recommandée) : utilisateur MariaDB dédié, en lecture seule :
#   CREATE USER 'dp_fede_backup'@'localhost' IDENTIFIED BY '<mot de passe fort>';
#   GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT ON dp_fede.* TO 'dp_fede_backup'@'localhost';
# Option B : laisser DB_USER vide → authentification unix_socket de root
#   (le script tourne en root via cron), aucun mot de passe stocké.
DB_USER=dp_fede_backup
DB_PASSWORD=CHANGEME

# ── Stockage local ──────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/dp-fede
# Nombre de jours de conservation des sauvegardes locales (≥ 1).
RETENTION_DAYS=14
# Taille minimale (octets) d'un dump compressé jugé plausible.
MIN_SIZE_BYTES=2048

# ── Copie distante (optionnelle) ────────────────────────────────────────────
# Exécutable appelé avec le chemin du .sql.gz ; code ≠ 0 = échec de la sauvegarde.
# Exemple fourni : deploy/backup-upload-rclone.sh (pCloud, S3, SFTP… via rclone).
#   sudo install -o root -g root -m 750 deploy/backup-upload-rclone.sh /usr/local/sbin/dp-fede-backup-upload
BACKUP_UPLOAD_HOOK=
# Destination rclone utilisée par l'exemple (ex. pcloud:Sauvegardes/dp-fede).
RCLONE_REMOTE=

# ── Notification (optionnelle) ──────────────────────────────────────────────
# Exécutable appelé avec : <OK|ERREUR> <message> <fichier ou vide>.
# Exemple fourni : deploy/backup-notify-mail.sh (sendmail / msmtp).
#   sudo install -o root -g root -m 750 deploy/backup-notify-mail.sh /usr/local/sbin/dp-fede-backup-notify
BACKUP_NOTIFY_HOOK=
BACKUP_MAIL_TO=
