{
  "name": "dp-fede/api",
  "description": "DP Assistant — backend PHP (FFESSM / Code du Sport)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "firebase/php-jwt": "^7.0",
    "mpdf/mpdf": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^13"
  },
  "autoload": {
    "classmap": [
      "lib/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "DpFede\\Tests\\": "tests-php/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --colors=always",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l > /dev/null",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.5.11"
    }
  }
}
