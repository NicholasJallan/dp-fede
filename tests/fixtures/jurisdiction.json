    { "pays": "ES", "club": "PF", "out": "FR", "desc": "pays ES + club PF → FR (le lieu prime)" },
    { "pays": null, "club": "PF", "out": "PF", "desc": "pays null + club PF → PF (repli sur club)" },
    { "pays": "", "club": "PF", "out": "PF", "desc": "pays vide + club PF → PF (repli sur club)" },
    { "pays": "   ", "club": "PF", "out": "PF", "desc": "pays blancs + club PF → PF (repli sur club)" },
    { "pays": null, "club": "FR", "out": "FR", "desc": "pays null + club FR → FR (repli sur club)" },
    { "pays": "", "club": "FR", "out": "FR", "desc": "pays vide + club FR → FR (repli sur club)" },
    { "pays": null, "club": null, "out": "FR", "desc": "pays null + club null → FR (défaut)" },
