      "expected": [
        { "diveId": "dive-6", "diverId": "guide", "profMax": 20, "duree": 40, "trimix": false },
        { "diveId": "dive-6", "diverId": "d1", "profMax": 20, "duree": 40, "trimix": false },
        { "diveId": "dive-6", "diverId": "guide", "profMax": 15, "duree": 35, "trimix": false },
        { "diveId": "dive-6", "diverId": "d2", "profMax": 15, "duree": 35, "trimix": false }
      ]
