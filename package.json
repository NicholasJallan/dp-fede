{
  "name": "dp-assistant",
  "version": "1.0.0",
  "description": "Outil d'aide au Directeur de Plongée (FFESSM / Code du Sport)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node --test --test-reporter=spec 'tests/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:php": "cd backend && composer test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
