{
  "name": "dp-fede/api",
  "description": "DP Assistant — backend PHP (FFESSM / Code du Sport)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "firebase/php-jwt": "^7.0",
    "mpdf/mpdf": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "classmap": [
      "lib/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "DpFede\\Tests\\": "tests-php/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --colors=always"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.28"
    }
  }
}
