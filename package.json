{
  "name": "dp-assistant",
  "version": "1.0.0",
  "description": "Outil d'aide au Directeur de Plongée (FFESSM / Code du Sport)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node --test --test-reporter=spec 'tests/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:php": "cd backend && composer test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,css,json,md}\"",
    "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
